{
  "daily_cron": {
    "description": "每日爬取并推送 Cron",
    "type": "string",
    "default": "0 8 * * *",
    "hint": "标准 5 段 Cron 表达式；修改后需要重载插件。"
  },
  "timezone": {
    "description": "Cron 时区",
    "type": "string",
    "default": "Asia/Shanghai"
  },
  "startup_update": {
    "description": "插件加载后自动更新",
    "type": "bool",
    "default": true,
    "hint": "首次安装时建议开启，用于抓取最近几页商品。"
  },
  "enabled_categories": {
    "description": "爬取/展示类目",
    "type": "object",
    "items": {
      "3D衣装": {
        "description": "3D服装",
        "type": "bool",
        "default": true
      },
      "3Dモデル（その他）": {
        "description": "3D模型(其他)",
        "type": "bool",
        "default": false
      },
      "3D小道具": {
        "description": "3D小道具",
        "type": "bool",
        "default": false
      },
      "3Dテクスチャ": {
        "description": "3D贴图",
        "type": "bool",
        "default": false
      },
      "3D装飾品": {
        "description": "3D装饰品",
        "type": "bool",
        "default": false
      },
      "3D環境・ワールド": {
        "description": "3D环境/世界",
        "type": "bool",
        "default": false
      },
      "3D髪型": {
        "description": "3D发型",
        "type": "bool",
        "default": true
      },
      "3D靴": {
        "description": "3D鞋子",
        "type": "bool",
        "default": false
      },
      "ソフトウェア": {
        "description": "软件",
        "type": "bool",
        "default": false
      }
    }
  },
  "category_quota": {
    "description": "类目配额",
    "type": "object",
    "hint": "每个已启用类目每档推送的数量；0 表示不推送该类目。",
    "items": {
      "3D衣装": {
        "description": "3D服装（每档数量）",
        "type": "int",
        "default": 6
      },
      "3Dモデル（その他）": {
        "description": "3D模型(其他)（每档数量）",
        "type": "int",
        "default": 4
      },
      "3D小道具": {
        "description": "3D小道具（每档数量）",
        "type": "int",
        "default": 4
      },
      "3Dテクスチャ": {
        "description": "3D贴图（每档数量）",
        "type": "int",
        "default": 4
      },
      "3D装飾品": {
        "description": "3D装饰品（每档数量）",
        "type": "int",
        "default": 4
      },
      "3D環境・ワールド": {
        "description": "3D环境/世界（每档数量）",
        "type": "int",
        "default": 4
      },
      "3D髪型": {
        "description": "3D发型（每档数量）",
        "type": "int",
        "default": 4
      },
      "3D靴": {
        "description": "3D鞋子（每档数量）",
        "type": "int",
        "default": 4
      },
      "ソフトウェア": {
        "description": "软件（每档数量）",
        "type": "int",
        "default": 4
      }
    }
  },
  "crawl_pages": {
    "description": "每次爬取最大页数",
    "type": "int",
    "default": 5
  },
  "crawl_workers": {
    "description": "详情并发数",
    "type": "int",
    "default": 4
  },
  "crawl_delay": {
    "description": "请求间隔（秒）",
    "type": "float",
    "default": 0.3,
    "hint": "全局请求最小间隔，并发下同样生效。"
  },
  "http_timeout": {
    "description": "HTTP 超时（秒）",
    "type": "int",
    "default": 30
  },
  "http_proxy": {
    "description": "HTTP 代理",
    "type": "string",
    "default": "",
    "hint": "留空使用系统代理设置；需要直连时填写 http://127.0.0.1:端口。"
  },
  "llm_provider": {
    "description": "翻译模型",
    "type": "string",
    "_special": "select_provider",
    "default": "",
    "hint": "留空时使用 AstrBot 当前默认对话模型；关闭翻译时保留日文原标题。"
  },
  "enable_translation": {
    "description": "启用标题翻译",
    "type": "bool",
    "default": true
  },
  "push_targets": {
    "description": "推送目标",
    "type": "list",
    "items": {"type": "string"},
    "default": [],
    "hint": "填写 umo，与 /booth bind 绑定的订阅取并集。"
  },
  "send_text": {
    "description": "推送附带文字清单",
    "type": "bool",
    "default": false,
    "hint": "开启后长图之外附送纯文本商品清单；默认只发长图。"
  },
  "text_footer": {
    "description": "文本末尾自定义信息",
    "type": "string",
    "default": "数据来源：https://github.com/xueayi/astrbot_plugin_booth_push",
    "hint": "显示在长图底部；send_text 开启时也显示在纯文本清单最后一行。留空时长图底部显示默认来源。"
  },
  "font_path": {
    "description": "中文字体路径",
    "type": "string",
    "default": "",
    "hint": "留空时自动探测系统字体，必要时下载并缓存 Noto Sans SC。"
  }
}
